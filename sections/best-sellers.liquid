{{ 'section-best-sellers.css' | asset_url | stylesheet_tag }}

<div class="best-sellers-section page-width" data-split-section="{{ section.id }}">
  <div class="best-sellers-split-container">
    <div class="best-sellers-menu-left">
      {%- if section.settings.title_uptext != blank -%}
        <h3 class="best-sellers__title-uptext {{ section.settings.title_uptext_alignment }} {{ section.settings.title_uptext_text_size }} {{ section.settings.title_uptext_color_scheme }}">
          {{ section.settings.title_uptext | escape }}
        </h3>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="best-sellers__title {{ section.settings.title_alignment }} {{ section.settings.title_text_size }} {{ section.settings.title_color_scheme }}">
          {{ section.settings.title | escape }}
        </h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign current_collection = collections[block.settings.collection] -%}
          {%- assign display_title = block.settings.collection_title -%}
          {%- if display_title == blank -%}
            {%- if current_collection != blank -%}
              {%- assign display_title = current_collection.title -%}
            {%- else -%}
              {%- assign display_title = 'Collection name' | append: forloop.index -%}
            {%- endif -%}
          {%- endif -%}

          <button
            class="menu-collection-btn medium-text{% if forloop.first %} active{% endif %}"
            data-target-product="prod-{{ section.id }}-{{ forloop.index }}" data-menu-collection-btn
            {{ block.shopify_attributes }}
          >
            <span class="menu-collection-title big-text">{{ display_title | escape }}</span>
            <span class="menu-arrow">
              <svg
                class="light-gray"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                fill="none"
                viewBox="0 0 24 24"
              >
                <path stroke="#535353" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" stroke-width="1.5" d="M14.43 5.93 20.5 12l-6.07 6.07M3.5 12h16.83"/>
              </svg>
            </span>
          </button>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="best-sellers-product-right">
        {%- for block in section.blocks -%}
          {%- assign current_collection = collections[block.settings.collection] -%}

          {%- assign target_product = block.settings.custom_product -%}
          {%- if target_product == blank and current_collection != blank -%}
            {%- assign target_product = current_collection.products | first -%}
          {%- endif -%}

          <div
            id="prod-{{ section.id }}-{{ forloop.index }}"
            class="split-product-panel{% if forloop.first %} active{% endif %}" data-product-panel
          >
            {%- if target_product != blank -%}
              <div class="split-product-card">
                <div class="split-product-media">
                  <a href="{{ target_product.url | within: current_collection }}" aria-label="{{ target_product.title | escape }}">
                    {%- if target_product.featured_media != blank -%}
                      <picture>
                        <source
                          media="(min-width: 750px)"
                          srcset="{{ target_product.featured_media | image_url: width: 550 }} 1x, {{ target_product.featured_media | image_url: width: 1100 }} 2x"
                          width="550"
                          height="{{ 550 | divided_by: target_product.featured_media.aspect_ratio | round }}"
                        >
                        <img
                          src="{{ target_product.featured_media | image_url: width: 350 }}"
                          srcset="{{ target_product.featured_media | image_url: width: 350 }} 1x, {{ target_product.featured_media | image_url: width: 700 }} 2x"
                          alt="{{ target_product.featured_media.alt | escape }}"
                          loading="lazy"
                          width="350"
                          height="{{ 350 | divided_by: target_product.featured_media.aspect_ratio | round }}"
                          class="split-product-img"
                        >
                      </picture>
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </a>

                  <div class="product-badges">
                    {%- assign badge_count = 0 -%}

                    {%- if target_product.available == false -%}
                      <span class="badge badge-sold-out super-small-text">Sold out</span>
                      {%- assign badge_count = badge_count | plus: 1 -%}
                    {%- elsif target_product.compare_at_price > target_product.price -%}
                      <span class="badge badge--sale super-small-text">Sale</span>
                      {%- assign badge_count = badge_count | plus: 1 -%}
                    {%- endif -%}

                    {%- if badge_count < 3 -%}
                      <span class="badge badge--custom super-small-text">New</span>
                      {%- assign badge_count = badge_count | plus: 1 -%}
                    {%- endif -%}

                    {%- for tag in target_product.tags -%}
                      {%- if badge_count >= 3 -%}{%- break -%}{%- endif -%}
                      {%- assign tag_down = tag | downcase -%}
                      {%- unless tag_down == 'sale' or tag_down == 'new' -%}
                        <span class="badge badge--custom badge--{{ tag | handleize }} super-small-text">{{ tag }}</span>
                        {%- assign badge_count = badge_count | plus: 1 -%}
                      {%- endunless -%}
                    {%- endfor -%}
                  </div>

                  <div class="product-actions">
                    <button
                      type="button"
                      class="action-btn action-btn--wishlist"
                      data-product-title="{{ target_product.title | escape }}"
                      data-open-wishlist
                      aria-label="Add to wishlist"
                    >
                      <svg
                        viewBox="0 0 24 24"
                        width="18"
                        height="18"
                        stroke="currentColor"
                        stroke-width="2"
                        fill="none"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                      </svg>
                    </button>
                    <button
                      type="button"
                      class="action-btn action-btn--quick-add"
                      data-variant-id="{{ target_product.first_available_variant.id }}"
                      data-add-product-to-cart
                      {% unless target_product.available %}
                        disabled
                      {% endunless %}
                      aria-label="Quick add to cart"
                    >
                      <svg
                        viewBox="0 0 24 24"
                        width="18"
                        height="18"
                        stroke="currentColor"
                        stroke-width="2"
                        fill="none"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>
                      </svg>
                    </button>
                  </div>
                </div>

                <a href="{{ target_product.url | within: current_collection }}" class="product-info">
                  <h3 class="product-title small-text dark">{{ target_product.title | escape }}</h3>
                  <div class="split-product-price">
                    {%- if target_product.compare_at_price > target_product.price -%}
                      <span class="small-text accent">{{ target_product.price | money }}</span>
                      <s class="small-text light-gray">{{ target_product.compare_at_price | money }}</s>
                    {%- else -%}
                      <span class="price-regular dark">{{ target_product.price | money }}</span>
                    {%- endif -%}
                  </div>
                </a>
              </div>
            {%- else -%}
              <div class="split-product-card placeholder-card">
                <div class="split-product-media">
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                <div class="split-product-info">
                  <h3 class="split-product-title">Please choose the collection</h3>
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="wishlist-overlay" id="WishlistOverlay" data-wishlist-overlay>
    <div class="wishlist-modal" role="dialog" aria-modal="true" aria-labelledby="WishlistProductTitle">
      <button
        type="button"
        class="wishlist-modal__close"
        id="WishlistClose"
        aria-label="Close modal"
        data-wishlist-close
      >
        &times;
      </button>
      <div class="wishlist-modal__content">
        <span id="WishlistProductTitle" class="wishlist-product-name" data-wishlist-product-title></span>
      </div>
    </div>
  </div>
</div>

<script src="{{ 'section-best-sellers.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Best Sellers",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title_uptext",
      "label": "Title uptext",
      "default": "Best Sellers"
    },
    {
      "type": "select",
      "id": "title_uptext_text_size",
      "options": [
        { "value": "super-small-text", "label": "Super Small Text" },
        { "value": "small-text", "label": "Small Text" },
        { "value": "medium-text", "label": "Medium Text" },
        { "value": "big-text", "label": "Big Text" },
        { "value": "super-big-text", "label": "Super Big Text" }
      ],
      "default": "small-text",
      "label": "Title uptext text size"
    },
    {
      "type": "select",
      "id": "title_uptext_color_scheme",
      "label": "Title uptext color",
      "options": [
        { "value": "light-gray", "label": "Light gray" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "light-gray"
    },

    {
      "type": "select",
      "id": "title_uptext_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Alignment"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Trending Products"
    },
    {
      "type": "select",
      "id": "title_text_size",
      "options": [
        { "value": "super-small-text", "label": "Super Small Text" },
        { "value": "small-text", "label": "Small Text" },
        { "value": "medium-text", "label": "Medium Text" },
        { "value": "big-text", "label": "Big Text" },
        { "value": "super-big-text", "label": "Super Big Text" }
      ],
      "default": "super-big-text",
      "label": "Title text size"
    },
    {
      "type": "select",
      "id": "title_color_scheme",
      "label": "Title color",
      "options": [
        { "value": "light-gray", "label": "Light gray" },
        { "value": "dark", "label": "Dark" },
        { "value": "accent", "label": "Accent" }
      ],
      "default": "dark"
    },

    {
      "type": "select",
      "id": "title_alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Alignment"
    }
  ],

  "blocks": [
    {
      "type": "collection_list",
      "name": "Collection list",
      "limit": 3,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Add Collection"
        },
        {
          "type": "text",
          "id": "collection_title",
          "label": "Collection title",
          "info": "Update collection title"
        },
        {
          "type": "product",
          "id": "custom_product",
          "label": "Product",
          "info": "Replace featured product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best Sellers",
      "blocks": [{ "type": "collection_list" }, { "type": "collection_list" }, { "type": "collection_list" }]
    }
  ]
}
{% endschema %}
